{
  "name": "cstman-installer",
  "version": "4.1.0",
  "description": "CSTMAN installer — detects your AI coding agents and installs cstman for each one.",
  "license": "MIT",
  "author": "Julius Brussee",
  "homepage": "https://github.com/ShiroGx1/cstman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShiroGx1/cstman.git"
  },
  "bugs": {
    "url": "https://github.com/ShiroGx1/cstman/issues"
  },
  "bin": {
    "cstman-install": "./installer/install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-force-exit --test-concurrency=2 tests/installer/*.test.mjs tests/hooks/*.test.mjs",
    "test:windows": "node scripts/test-windows-compat.mjs"
  },
  "files": [
    ".cursor-plugin/",
    "installer/",
    ".codex/codex-sessionstart.js",
    "hooks/",
    "src/",
    "agents/",
    "skills/",
    "plugins/",
    "commands/",
    "dist/cstman.skill",
    "README.md",
    "LICENSE",
    "NOTICE",
    "!**/__pycache__/**",
    "!**/*.py[cod]"
  ],
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "cstman": "workspace:^4.1.0"
  }
}
